# =========================================================
# VERİTABANI
# =========================================================

# Yerel geliştirme bağlantısı
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=Intellidesk
DB_USER=postgres
DB_PASSWORD=your_local_database_password

# Production ortamında Neon Direct connection string kullanılır.
# Dolu olduğunda yukarıdaki ayrı DB değişkenlerinden önceliklidir.
DATABASE_URL=

# =========================================================
# AUTH
# =========================================================

JWT_SECRET_KEY=replace_with_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================================================
# CORS
# =========================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================================================
# DOSYA YÜKLEME
# =========================================================

UPLOAD_ROOT=uploads
MAX_ATTACHMENT_SIZE_MB=10
MAX_AI_SESSION_ATTACHMENTS=3

# =========================================================
# YAPAY ZEKÂ
# =========================================================

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60